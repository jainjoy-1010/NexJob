# Frontend Environment Variables (Vite)
# Copy this file to .env.development or .env.production and adjust the values
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ----------------------------------------------------
# Backend Environment Variables (for Render Production)
# ----------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://<render-db-host>:<port>/<dbname>
# SPRING_DATASOURCE_USERNAME=<db-username>
# SPRING_DATASOURCE_PASSWORD=<db-password>
# JWT_SECRET=<your-very-secure-jwt-secret>
# FRONTEND_URL=https://your-frontend.vercel.app
# PORT=8080 (Render automatically provides this)

# Note on File Uploads:
# Render free tier and standard web services have an ephemeral filesystem.
# This means files uploaded to the `uploads/` directory will be lost on every deploy or restart.
# For production, it is highly recommended to integrate an external object storage like AWS S3, Google Cloud Storage, or Cloudinary.
